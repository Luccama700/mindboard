# URC agent config - copy to worker/urc.env (gitignored) and fill in.
# worker/urc-agent.mjs RE-READS this file every 5s poll, so changing a value
# here takes effect within one poll. No restart needed.

# Where Mindboard is deployed (no trailing slash).
MINDBOARD_URL=https://mindboard-livid.vercel.app

# The device token printed once by:
#   node scripts/urc-register-device.mjs --user <your uuid> --name "home-pc"
# It only works on POST /api/urc/device. Never paste it anywhere else.
URC_DEVICE_TOKEN=urcd_replace_me

# The Supabase user id URC belongs to. The agent ignores every job whose
# user_id is not exactly this, no matter what the server says.
URC_OWNER_USER_ID=00000000-0000-0000-0000-000000000000

# THE KILL SWITCH. Anything other than true/1/yes/on reads as off: the agent
# kills the sessions it started, reports them stopped, stops heartbeating (so
# the server also sees the PC as offline) and idles until this flips back.
URC_ENABLED=false

# Permission mode for spawned sessions, and the ONLY place it can be set.
# false  -> no permission flags at all; the session asks before acting.
# true   -> --dangerously-skip-permissions; the session acts without asking in
#           whatever folder it was started in. Lucca sets this deliberately;
#           nothing on the server or in a job can turn it on.
URC_BYPASS_PERMISSIONS=false
